{
  "mcpServers": {
    "Motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "Motion+": {
      "type": "http",
      "url": "https://mcp.motion.dev/plus"
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "brave-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--executablePath",
        "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
